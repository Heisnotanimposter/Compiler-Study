%{
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include "y.tab.h" // Generated by Bison

void yyerror(const char *s);
%}

%%


"if"        { return IF; }
"else"      { return ELSE; }
"return"    { return RETURN; }
"=="        { return EQ; }
"<"         { return LT; }
">"         { return GT; }
"{"         { return LBRACE; }
"}"         { return RBRACE; }
[0-9]+      { yylval.ival = atoi(yytext); return NUMBER; }
[a-zA-Z_][a-zA-Z0-9_]* { yylval.sval = strdup(yytext); return IDENTIFIER; }
"="         { return ASSIGN; }
"+"         { return PLUS; }
"-"         { return MINUS; }
"*"         { return MUL; }
"/"         { return DIV; }
";"         { return SEMICOLON; }
"("         { return LPAREN; }
")"         { return RPAREN; }
[ \t\n]     { /* ignore whitespace */ }
.           { printf("Unknown character: %s\n", yytext); }

%%

int yywrap() {
    return 1;
}
