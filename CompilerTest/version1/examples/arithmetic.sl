/*
 * Example 1: Basic Arithmetic Operations
 * 
 * This program demonstrates:
 * - Variable declarations (int and float)
 * - Assignment statements
 * - Arithmetic operations (+, -, *, /)
 * - Integer and floating-point numbers
 */

int a;
int b;
int sum;
int difference;
int product;
int quotient;

float x;
float y;
float result;

/* Integer operations */
a = 10;
b = 5;
sum = a + b;           // 15
difference = a - b;    // 5
product = a * b;       // 50
quotient = a / b;      // 2

/* Float operations */
x = 10.5;
y = 2.5;
result = x + y;        // 13.0
result = x - y;        // 8.0
result = x * y;        // 26.25
result = x / y;        // 4.2

/* Mixed expressions */
result = a + x;        // 20.5
result = a * y;        // 25.0

